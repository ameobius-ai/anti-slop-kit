{
  "principals": [
    "ANY_ANONYMOUS",
    "GROUP:authenticated_users",
    "GROUP:administrators",
    "SERVICE:payment-gateway"
  ],
  "resources": [
    "/api/v1/public/*",
    "/api/v1/user/*",
    "/api/v1/admin/*",
    "/api/v1/internal/payments"
  ],
  "conditions": [
    "rate_limit(100/minute)",
    "token_valid()",
    "token_scope(\"read:user\")",
    "mfa_verified()",
    "ip_whitelist(\"10.0.0.0/8\")",
    "mtls_certificate(\"payment-gateway.cert\")"
  ],
  "actions": [
    "ALLOW",
    "DENY"
  ]
}