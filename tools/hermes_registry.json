{
  "version": "1.0.0",
  "schema_version": "openai_function_calling_v1",
  "hermes_agent_version": "1.0.0",
  "tools": [
    {
      "name": "lint_file",
      "implementation": "tools.aslint.lint_tool.lint_file",
      "definition": {
        "name": "lint_file",
        "description": "Analyze markdown file for anti-slop patterns",
        "parameters": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "enum": [
                "en",
                "ru",
                "es"
              ]
            },
            "format": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "github"
              ]
            }
          },
          "required": [
            "file_path"
          ]
        }
      }
    },
    {
      "name": "lint_text",
      "implementation": "tools.aslint.lint_tool.lint_text",
      "definition": {
        "name": "lint_text",
        "description": "Analyze text content for anti-slop patterns",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "enum": [
                "en",
                "ru",
                "es"
              ]
            }
          },
          "required": [
            "text"
          ]
        }
      }
    },
    {
      "name": "rewrite_section",
      "implementation": "tools.aslint.rewrite_tool.rewrite_section",
      "definition": {
        "name": "rewrite_section",
        "description": "Rewrite text to improve clarity",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "enum": [
                "en",
                "ru",
                "es"
              ]
            },
            "instructions": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "language"
          ]
        }
      }
    },
    {
      "name": "transmit_check",
      "implementation": "tools.aslint.transmit_check.transmit_check",
      "definition": {
        "name": "transmit_check",
        "description": "Validate fidelity during transmission",
        "parameters": {
          "type": "object",
          "properties": {
            "original": {
              "type": "string"
            },
            "transmitted": {
              "type": "string"
            },
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "original",
            "transmitted"
          ]
        }
      }
    }
  ]
}